{
  "info": {
    "name": "Student Information API",
    "description": "Use with a local seeded database. Run one of the Login as Admin/Registrar/Faculty/Student requests first; every request then runs as that user until you log in as someone else. Use Me to check who is logged in. Academic requests need Registrar. Run Student login for forbidden cases (it keeps the current user) only before the forbidden-access cases. Create requests save generated IDs for updates and cleanup. Requests mutate local demo data; run cleanup requests after the demonstration.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
